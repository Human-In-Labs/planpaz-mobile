+import { CultivatedPlant } from '../../features/garden/types';
+
+export function mapGardenPlantToCultivatedPlant(item: GardenPlant): CultivatedPlant {
+    const defaultImage = require('../../assets/images/auth-banner.png');
+
+    const speciesName = item.plant?.name || 'Planta';
+    const scientificName = item.plant?.scientificName || '';
+    const room = item.room ? (ROOM_ENUM_TO_LABEL[item.room] || item.room) : 'Quintal';
+    const directRainStr = item.directRain ? 'Sim' : 'Não';
+    const reminders = item.wateringNotification ?? true;
+
+    let daysCultivated = 1;
+    let plantingDateStr = '01/01/2026';
+    if (item.plantedAt) {
+        const plantedDate = new Date(item.plantedAt);
+        if (!isNaN(plantedDate.getTime())) {
+            const diffTime = Math.abs(new Date().getTime() - plantedDate.getTime());
+            daysCultivated = Math.max(1, Math.ceil(diffTime / (1000 * 60 * 60 * 24)));
+            plantingDateStr = `${String(plantedDate.getDate()).padStart(2, '0')}/${String(plantedDate.getMonth() + 1).padStart(2, '0')}/${plantedDate.getFullYear()}`;
+        }
+    }
+
+    const tags = [
+        item.plant?.type || 'Ornamental',
+        item.plant?.size || 'Pequena',
+        item.plant?.luminosityLevel || 'Média',
+        item.plant?.wateringLevel || 'Frequente',
+    ];
+
+    const description = item.plant?.description || 'Planta cultivada no jardim PlanPaz.';
+
+    return {
+        id: String(item.id),
+        nickname: item.nickname || speciesName,
+        species: speciesName,
+        scientificName: scientificName,
+        image: item.imagePath ? { uri: item.imagePath } : defaultImage,
+        daysCultivated: daysCultivated,
+        room: room,
+        stage: item.stage?.name || 'Muda',
+        directRain: directRainStr,
+        reminders: reminders,
+        plantingDate: plantingDateStr,
+        tags: tags,
+        description: description,
+        careGuide: {
+            solo: 'Solo rico em matéria orgânica com boa drenagem.',
+            rega: 'Mantenha o solo levemente úmido. Evite encharcamento.',
+            poda: 'Retire folhas secas ou amareladas para estimular novos brotos.',
+        },
+        stats: {
+            co2: Math.round(daysCultivated * 0.45 * 10) / 10,
+            ecoScore: Math.min(100, Math.round(daysCultivated * 1.5 + 50)),
+            cultivationDays: daysCultivated,
+        },
+        stages: [
+            {
+                id: 's1',
+                title: 'Estágio inicial',
+                label: 'Muda',
+                description: 'Fase inicial do cultivo.',
+                image: defaultImage,
+            },
+            {
+                id: 's2',
+                title: 'Estágio atual',
+                label: item.stage?.name || 'Crescimento',
+                description: 'Planta em desenvolvimento ativo.',
+                image: defaultImage,
+            },
+        ],
+        careActions: [
+            {
+                id: 'ca1',
+                type: 'rega',
+                title: 'Rega regular',
+                status: item.lastWatering ? `Última rega em ${new Date(item.lastWatering).toLocaleDateString()}` : 'Agendada',
+                isOverdue: false,
+                icon: 'shower',
+                completed: false,
+            },
+        ],
+    };
 }
